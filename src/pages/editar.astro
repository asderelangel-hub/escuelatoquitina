        </div>
      </article>`;

    $("vista-noticia").innerHTML = `
      <article>
        <header class="relative overflow-hidden text-white pt-16 pb-14" style="background:var(--color-primary-dark)">
          ${portada ? `<img src="${esc(portada)}" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30">` : ""}
          <div class="rayos absolute inset-0 opacity-20"></div>
          <div class="container-x relative max-w-3xl">
            <span class="mt-5 inline-block text-[0.72rem] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full" style="background:var(--color-accent);color:var(--color-ink)">${esc(d.categoria)}</span>
            <h1 class="mt-4 text-3xl sm:text-4xl font-black leading-tight">${titulo}</h1>
