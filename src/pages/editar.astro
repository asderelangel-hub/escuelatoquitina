  $("ver").addEventListener("click", abrirVista);
  $("vista-cerrar").addEventListener("click", cerrarVista);
  $("vista-publicar").addEventListener("click", () => { cerrarVista(); publicar(); });

  // ═════════════ Progreso ═════════════
  function progreso(titulo: string, texto = "", pct: number | null = null, icono: "girando" | "ok" | "mal" = "girando") {
    mostrar($("progreso"));
    $("prog-titulo").textContent = titulo;
    $("prog-texto").textContent = texto;
    $("prog-icono").className = icono === "girando" ? "girando mx-auto mb-4" : `icono-${icono} mx-auto mb-4`;
    $("prog-icono").textContent = icono === "ok" ? "✓" : icono === "mal" ? "!" : "";
    mostrar($("prog-barra-caja"), pct !== null);
    if (pct !== null) $("prog-barra").style.width = `${Math.max(3, Math.min(100, pct))}%`;
    $("prog-acciones").innerHTML = "";
  }

  function accion(texto: string, clase: string, fn: () => void, href?: string) {
    const el = document.createElement(href ? "a" : "button");
    el.className = `btn ${clase} justify-center`;
    el.textContent = texto;
    if (href) { (el as HTMLAnchorElement).href = href; (el as HTMLAnchorElement).target = "_blank"; (el as HTMLAnchorElement).rel = "noopener"; }
    else (el as HTMLButtonElement).type = "button";
    el.addEventListener("click", fn);
    $("prog-acciones").appendChild(el);
  }

  function cerrarProgreso() { mostrar($("progreso"), false); }

  // Sigue el deploy automático (GitHub Actions) hasta que el cambio está en la web.
  async function seguirDeploy(commit: string, textos: { titulo: string; listo: string; enlace?: string }, despues?: () => void) {
    const inicio = Date.now();
    const ESPERADO = 200_000;
    progreso(textos.titulo, "Tarda entre 2 y 4 minutos. Puedes cerrar esta página: el cambio se publica igual.", 8);
    while (Date.now() - inicio < 12 * 60_000) {
      await esperar(8000);
      $("prog-barra").style.width = `${Math.min(95, 8 + ((Date.now() - inicio) / ESPERADO) * 87)}%`;
      let estado = "";
      try { estado = (await api(`estado?commit=${commit}`)).estado; } catch { continue; }
      if (estado === "listo") {
        progreso("¡Listo! Ya está en la web", textos.listo, null, "ok");
        if (textos.enlace) accion("Ver la noticia", "btn-primary", () => {}, textos.enlace);
        despues?.();
        return;
      }
      if (estado === "error") {
        progreso("La web no se pudo actualizar", "El cambio quedó guardado, pero hubo un problema al publicarlo. Pandora Studio recibe un aviso automático y lo va a revisar; no hace falta que lo repitas.", null, "mal");
        accion("Cerrar", "btn-ghost", cerrarProgreso);
        return;
      }
    }
    progreso("Está tardando más de lo normal", "El cambio quedó guardado. Revisa la web en unos minutos; si no aparece, avísale a Pandora Studio.", null, "mal");
    accion("Cerrar", "btn-ghost", cerrarProgreso);
  }

  // ═════════════ Publicar ═════════════
  const blobABase64 = (b: Blob) =>
    new Promise<string>((ok, mal) => {
      const r = new FileReader();
      r.onload = () => ok(String(r.result).split(",")[1] || "");
      r.onerror = mal;
      r.readAsDataURL(b);
    });

  async function publicar(reemplazar = false) {
    if (ocupado) return;
    const errores = validar();
    if (errores.length) return mostrarErrores(errores);
    if (!fotos.length && !confirm("La noticia no tiene fotos. ¿Publicarla igual?")) return;

    ocupado = true;
    let repetirReemplazando = false;
    try {
      const nuevas = fotos.filter((f) => f.nueva && !f.sha);
      for (let i = 0; i < nuevas.length; i++) {
        progreso(`Subiendo foto ${i + 1} de ${nuevas.length}…`, "No cierres esta página mientras se suben las fotos.", (i / nuevas.length) * 100);
        const r = await api("fotos", { method: "POST", texto: await blobABase64(nuevas[i].blob!) });
        nuevas[i].sha = r.sha;
        nuevas[i].tipo = r.tipo;
      }
      progreso("Guardando la noticia…", "", 100);
      const d = leerFormulario();
      let r: { slug: string; commit: string } | null = null;
      try {
        r = await api("noticias", {
          method: "POST",
          json: {
            modo, slug: slugEditando, reemplazar, ...d,
            fotos: fotos.map((f) => (f.nueva ? { sha: f.sha, tipo: f.tipo } : { ruta: f.ruta })),
          },
        });
      } catch (e) {
        if (!(e instanceof ErrorApi && e.codigo === "existe")) throw e;
        cerrarProgreso();
        repetirReemplazando = confirm("Ya hay una noticia publicada con este mismo título.\n\n¿Quieres reemplazarla por esta? Si es una noticia distinta, toca «Cancelar» y cambia el título.");
      }
      if (r) {
        const { slug, commit } = r;
        const titulo = d.title.trim();
        const editaba = modo === "editar";
        lsBorrar(LS_BORRADOR);
        reiniciar();
        listaCargada = false;
        await seguirDeploy(
          commit,
          {
            titulo: editaba ? "Corrección guardada. Publicando…" : "Noticia guardada. Publicando…",
            listo: `«${titulo}» ya se ve en escuelatoqui.cl.`,
            enlace: conBase(`/noticias/${slug}/`),
          },
          () => {
            accion("Escribir otra noticia", "btn-ghost", () => { cerrarProgreso(); irA("nueva"); });
            accion("Me equivoqué: ocultarla", "btn-ghost", () => cambiarVisible(slug, titulo, false));
          },
        );
      }
    } catch (e) {
      progreso("No se pudo publicar", (e as Error).message, null, "mal");
      accion("Cerrar e intentar de nuevo", "btn-ghost", cerrarProgreso);
    } finally {
      ocupado = false;
    }
    if (repetirReemplazando) publicar(true);
  }

  $("publicar").addEventListener("click", () => publicar());
  window.addEventListener("beforeunload", (e) => { if (ocupado) { e.preventDefault(); e.returnValue = ""; } });

  // ═════════════ Publicadas ═════════════
  async function cargarLista() {
    const estado = $("lista-estado");
    const ul = $("lista");
    estado.textContent = "Cargando…";
    mostrar(estado);
    ul.innerHTML = "";
    try {
      const { noticias } = await api("noticias");
      listaCargada = true;
      if (!noticias.length) { estado.textContent = "Todavía no hay noticias."; return; }
      mostrar(estado, false);
      for (const n of noticias) {
        const li = document.createElement("li");
        li.className = "tarjeta fila-noticia p-3";
        const fecha = /^\d{4}-\d{2}-\d{2}$/.test(n.pubDate) ? fechaLarga(n.pubDate) : "";
        li.innerHTML = `
          ${n.cover ? `<img src="${esc(conBase(n.cover))}" alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'sin-foto rayos'}))">` : `<div class="sin-foto rayos"></div>`}
          <div class="min-w-0">
            <p class="font-bold leading-snug line-clamp-2">${esc(n.title)}</p>
            <p class="text-xs text-[var(--color-muted)] mt-1">${esc(fecha)} · ${esc(n.categoria)}${n.visible ? "" : '<span class="oculta-tag">Oculta</span>'}</p>
          </div>
          <div class="acciones">
            ${n.visible ? `<a href="${esc(conBase(`/noticias/${n.slug}/`))}" target="_blank" rel="noopener">Ver</a>` : ""}
            <button type="button" data-accion="corregir">Corregir</button>
            <button type="button" data-accion="visible" class="${n.visible ? "peligro" : ""}">${n.visible ? "Ocultar" : "Mostrar"}</button>
          </div>`;
        li.querySelector('[data-accion="corregir"]')!.addEventListener("click", () => corregir(n.slug));
        li.querySelector('[data-accion="visible"]')!.addEventListener("click", () => cambiarVisible(n.slug, n.title, !n.visible));
        ul.appendChild(li);
      }
    } catch (e) {
      estado.textContent = (e as Error).message;
    }
  }
  $("recargar").addEventListener("click", cargarLista);

  // Separa las fotos que van al final del texto (galería) del resto.
  function separarCuerpo(cuerpo: string) {
    const lineas = cuerpo.replace(/\r\n?/g, "\n").trimEnd().split("\n");
    const galeria: string[] = [];
    while (lineas.length) {
      const l = lineas[lineas.length - 1].trim();
      if (!l) { lineas.pop(); continue; }
      const m = l.match(/^!\[[^\]]*\]\((\/images\/noticias\/[^)\s]+)\)$/);
      if (!m) break;
      galeria.unshift(m[1]);
      lineas.pop();
    }
    return { texto: lineas.join("\n").trim().replace(/&lt;/g, "<"), galeria };
  }

  async function corregir(slug: string) {
    if (!formularioVacio() && !confirm("Tienes una noticia a medio escribir. ¿Descartarla para corregir esta otra?")) return;
    progreso("Abriendo la noticia…");
    try {
      const { noticia: n } = await api(`noticias/${encodeURIComponent(slug)}`);
      reiniciar();
      const { texto, galeria } = separarCuerpo(n.cuerpo);
      modo = "editar";
      slugEditando = slug;
      tituloEditando = n.title;
      llenarFormulario({ title: n.title, description: n.description, categoria: n.categoria, pubDate: n.pubDate, texto });
      if (!CATEGORIAS.includes(n.categoria)) {
        // Categorías antiguas que ya no están en la lista: se conservan.
        const op = document.createElement("option");
        op.value = op.textContent = n.categoria;
        campo("categoria").appendChild(op);
        campo("categoria").value = n.categoria;
      }
      fotos = [...(n.cover ? [n.cover] : []), ...galeria].map((r) => ({ id: idAzar(), nueva: false, ruta: r, url: conBase(r) }));
      pintarFotos();
      $("editando-titulo").textContent = `«${n.title}»`;
      mostrar($("editando"));
      cerrarProgreso();
      irA("nueva");
      guardarBorrador();
    } catch (e) {
      progreso("No pude abrir la noticia", (e as Error).message, null, "mal");
      accion("Cerrar", "btn-ghost", cerrarProgreso);
    }
  }

  async function cambiarVisible(slug: string, titulo: string, visible: boolean) {
    const pregunta = visible
      ? `¿Volver a mostrar «${titulo}» en la web?`
      : `¿Ocultar «${titulo}» de la web?\n\nNo se borra: puedes volver a mostrarla desde «Publicadas».`;
    if (!confirm(pregunta)) return;
    progreso("Guardando…");
    try {
      const r = await api(`noticias/${encodeURIComponent(slug)}/visible`, { method: "POST", json: { visible } });
      listaCargada = false;
      await seguirDeploy(r.commit, {
        titulo: visible ? "Mostrando la noticia…" : "Ocultando la noticia…",
        listo: visible ? `«${titulo}» volvió a la web.` : `«${titulo}» ya no aparece en la web.`,
      }, () => accion("Cerrar", "btn-ghost", () => { cerrarProgreso(); if (!$("v-app").querySelector<HTMLElement>('[data-panel="lista"]')!.hidden) cargarLista(); }));
    } catch (e) {
      progreso("No se pudo guardar el cambio", (e as Error).message, null, "mal");
      accion("Cerrar", "btn-ghost", cerrarProgreso);
    }
  }

  // ═════════════ Ayuda ═════════════
  $("copiar-instrucciones").addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText($("instrucciones").textContent || "");
      btn.textContent = "¡Copiadas! Ahora pégalas en ChatGPT";
    } catch {
      $("instrucciones").closest("details")!.open = true;
      const sel = window.getSelection();
      const rango = document.createRange();
      rango.selectNodeContents($("instrucciones"));
      sel?.removeAllRanges();
      sel?.addRange(rango);
      btn.textContent = "Selecciona el texto de abajo y cópialo";
    }
  });

  iniciar();
</script>
