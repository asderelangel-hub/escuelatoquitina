---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NoticiaCard from "../components/NoticiaCard.astro";
import SelloCard from "../components/SelloCard.astro";
import RadioPlayer from "../components/RadioPlayer.astro";
import { withBase } from "../lib/base";
import { site, sellos } from "../data/site";

const posts = (await getCollection("noticias", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const [featured, ...rest] = posts;
const recientes = rest.slice(0, 4);
const galeria = posts.filter((p) => p.data.cover).slice(0, 7).map((p) => p.data.cover!);
---
<BaseLayout
  title="Escuela Nuevo Toqui Caupolicán · Cañete"
  description="Escuela Particular Nuevo Toqui Caupolicán, Cañete. 38 años educando con altas expectativas, identidad mapuche lafkenche y valores cristianos, de Pre-Kinder a 8° básico."
  transparentHeader
>
  <!-- ===================== HERO ===================== -->
  <section class="relative min-h-[92vh] flex items-center overflow-hidden">
    <img src={withBase("/images/site/hero.jpg")} alt="Comunidad Escuela Nuevo Toqui Caupolicán" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0" style="background:linear-gradient(100deg, color-mix(in srgb, var(--color-primary-dark) 92%, transparent) 0%, color-mix(in srgb, var(--color-primary-dark) 60%, transparent) 55%, color-mix(in srgb, var(--color-ink) 25%, transparent) 100%)"></div>
    <div class="rayos absolute inset-0 opacity-25 mix-blend-overlay"></div>

    <div class="container-x relative pt-28 pb-16 text-white">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-[var(--color-gold)] font-bold uppercase tracking-[0.2em] text-sm">
          <span class="h-px w-8 bg-[var(--color-gold)]"></span> {site.saludoMapudungun} · Bienvenidos
        </p>
        <h1 class="mt-5 text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.02]">
          Educamos con <span class="text-[var(--color-gold)]">identidad</span>, fe y altas expectativas.
        </h1>
        <p class="mt-6 text-lg text-white/85 max-w-xl leading-relaxed">
          Somos la Escuela Particular Nuevo Toqui Caupolicán de Cañete. Desde 1987 formamos
          integralmente a niños y niñas —de Pre-Kinder a 8° básico— rescatando la cultura
          mapuche lafkenche y los valores que fortalecen a nuestra comunidad.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href={withBase("/contacto")} class="btn btn-accent text-base">Postula a tu hijo/a</a>
          <a href={withBase("/historia")} class="btn btn-ghost !text-white !border-white/40 hover:!bg-white/10 hover:!border-white text-base">Conoce nuestra historia</a>
        </div>
        <div class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
          {[["38", "años de historia"], ["320+", "estudiantes"], ["Pre-K a 8°", "jornada completa"]].map(([n, l]) => (
            <div>
              <p class="font-[var(--font-display)] text-3xl font-black text-[var(--color-gold)]">{n}</p>
              <p class="text-sm text-white/70 uppercase tracking-wide">{l}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SELLOS ===================== -->
  <section class="py-[var(--space-section)] lg:py-[var(--space-section-lg)]">
    <div class="container-x">
      <div class="text-center max-w-2xl mx-auto">
        <p class="kicker">Nuestros sellos educativos</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Tres raíces que nos definen</h2>
        <p class="mt-4 text-[var(--color-muted)] text-lg">Cada día en la Toqui late al ritmo de tres convicciones que guían la formación de nuestros estudiantes.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {sellos.map((s) => <SelloCard titulo={s.titulo} texto={s.texto} icono={s.icono} />)}
      </div>
    </div>
  </section>

  <!-- ===================== QUIÉNES SOMOS ===================== -->
  <section class="py-[var(--space-section)] lg:py-[var(--space-section-lg)]" style="background:var(--color-surface-alt)">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative">
        <div class="absolute -top-4 -left-4 h-24 w-24 rounded-2xl" style="background:linear-gradient(135deg,var(--color-gold),var(--color-accent))"></div>
        <img src={withBase("/images/site/historia.png")} alt="Historia de la escuela" class="relative rounded-[var(--radius-card)] shadow-[var(--shadow-card)] w-full object-cover aspect-[4/3]" loading="lazy" />
      </div>
      <div>
        <p class="kicker">Quiénes somos</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Una historia hecha de vocación y comunidad</h2>
        <p class="mt-5 text-[var(--color-muted)] text-lg leading-relaxed">
          La Escuela Nuevo Toqui Caupolicán fue fundada en 1987 por Don José Guillermo
          Araneda Cáceres, quien llegó a trabajar incluso sin sueldo, movido por el amor a
          nuestras comunidades. De una escuela uni-docente con 30 estudiantes, hoy somos una
          comunidad de más de 320 niños y niñas.
        </p>
        <p class="mt-4 text-[var(--color-muted)] leading-relaxed">
          Contamos con Programa de Integración Escolar (PIE) y un equipo multiprofesional
          —fonoaudiología, psicología educativa y terapia ocupacional— para acompañar a cada
          estudiante en su camino.
        </p>
        <a href={withBase("/historia")} class="btn btn-primary mt-7">Leer nuestra historia</a>
      </div>
    </div>
  </section>

  <!-- ===================== VISIÓN & MISIÓN ===================== -->
  <section class="relative py-[var(--space-section)] lg:py-[var(--space-section-lg)] text-white overflow-hidden" style="background:var(--color-primary)">
    <div class="rayos absolute inset-0 opacity-25"></div>
    <div class="container-x relative grid gap-8 md:grid-cols-2">
      <div class="rounded-[var(--radius-card)] bg-white/10 backdrop-blur-sm p-8 border border-white/15">
        <h3 class="text-2xl font-bold flex items-center gap-3"><span class="text-[var(--color-gold)]">✶</span> Nuestra Visión</h3>
        <p class="mt-4 text-white/85 leading-relaxed">
          Educar y formar integralmente a nuestros alumnos con altas expectativas académicas,
          desarrollar una comunidad que rescate la cultura mapuche lafkenche y promover un
          estilo de vida inspirado en valores cristianos.
        </p>
      </div>
      <div class="rounded-[var(--radius-card)] bg-white/10 backdrop-blur-sm p-8 border border-white/15">
        <h3 class="text-2xl font-bold flex items-center gap-3"><span class="text-[var(--color-gold)]">☀</span> Nuestra Misión</h3>
        <p class="mt-4 text-white/85 leading-relaxed">
          Cubrir las necesidades académicas y formativas de los alumnos con un equipo
          multidisciplinario, innovar creativamente en metodologías de aprendizaje e
          incorporar medios tecnológicos que generen una experiencia educativa integral.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== NOTICIAS ===================== -->
  <section class="py-[var(--space-section)] lg:py-[var(--space-section-lg)]">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="kicker">Vida escolar</p>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Últimas noticias</h2>
        </div>
        <a href={withBase("/noticias")} class="btn btn-ghost">Ver todas las noticias</a>
      </div>

      {featured && (
        <div class="mt-10">
          <NoticiaCard slug={featured.id} title={featured.data.title} description={featured.data.description}
            cover={featured.data.cover} categoria={featured.data.categoria} pubDate={featured.data.pubDate} featured />
        </div>
      )}
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {recientes.map((p) => (
          <NoticiaCard slug={p.id} title={p.data.title} description={p.data.description}
            cover={p.data.cover} categoria={p.data.categoria} pubDate={p.data.pubDate} />
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== EQUIPO CTA ===================== -->
  <section class="py-[var(--space-section)]" style="background:var(--color-surface-alt)">
    <div class="container-x grid gap-8 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="kicker">Nuestro equipo</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Docentes que dejan huella</h2>
        <p class="mt-5 text-[var(--color-muted)] text-lg leading-relaxed">
          Un amplio equipo multiprofesional —directivos, docentes, educadoras diferenciales,
          psicólogo, fonoaudiólogos y terapeuta ocupacional— trabaja cada día para que la
          Nuevo Toqui sea lo que es.
        </p>
        <a href={withBase("/equipo")} class="btn btn-primary mt-7">Conoce al equipo</a>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {["Gestión", "Pre-escolar", "1er Ciclo", "2do Ciclo", "PIE", "Multidisciplinar"].map((a) => (
          <div class="rounded-xl bg-white p-4 text-center shadow-[var(--shadow-soft)] flex items-center justify-center min-h-[4.5rem]">
            <p class="font-bold text-[var(--color-primary)]">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== GALERÍA ===================== -->
  {galeria.length >= 4 && (
    <section class="py-[var(--space-section)] lg:py-[var(--space-section-lg)]">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="kicker">Registro fotográfico</p>
            <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Momentos de nuestra comunidad</h2>
          </div>
          <a href={withBase("/galeria")} class="btn btn-ghost">Ver galería</a>
        </div>
        <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3">
          {galeria.map((src) => (
            <a href={withBase("/galeria")} class="block overflow-hidden rounded-xl group">
              <img src={withBase(src.startsWith("/") ? src : "/" + src)} alt="" loading="lazy" class="h-full w-full object-cover aspect-square group-hover:scale-105 transition-transform duration-500" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== RADIO ===================== -->
  <section class="relative py-[var(--space-section)] lg:py-[var(--space-section-lg)] text-white overflow-hidden" style="background:var(--color-primary-dark)">
    <div class="rayos absolute inset-0 opacity-30"></div>
    <div class="container-x relative grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="kicker !text-[var(--color-gold)]">Radio Toqui Caupolicán</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold">Escúchanos en vivo</h2>
        <p class="mt-5 text-white/80 text-lg leading-relaxed max-w-md">
          Nuestra radio escolar es la voz de la comunidad: música, cultura y las historias
          que nos unen. Sintonízala desde cualquier lugar.
        </p>
        <a href={withBase("/radio")} class="btn btn-accent mt-7">Ir a la radio</a>
      </div>
      <RadioPlayer />
    </div>
  </section>
</BaseLayout>
