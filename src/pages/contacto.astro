---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

// Endpoint del formulario. Opciones (ver referencias del repo):
//  - contact.php propio en cPanel  → action = "/contact.php"  (reference_contactphp_mailer)
//  - Web3Forms                     → access_key (ahora requiere login)
// Por ahora placeholder; Felipe define el endpoint definitivo.
const FORM_ACTION = "/contact.php";
---
<BaseLayout
  title="Contacto · Escuela Nuevo Toqui Caupolicán"
  description="Contáctate con la Escuela Nuevo Toqui Caupolicán de Cañete. Consultas de matrícula, información y comunicación con nuestra comunidad educativa."
>
  <PageHeader kicker="Contacto" titulo="Conversemos"
    bajada="¿Quieres matricular a tu hijo o hija, o tienes una consulta? Escríbenos y te responderemos a la brevedad." />

  <section class="py-[var(--space-section)] lg:py-[var(--space-section-lg)]">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <!-- Datos -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold">Nuestra escuela</h2>
        <p class="mt-4 text-[var(--color-muted)] leading-relaxed max-w-md">
          Estamos en el sector de Paicaví Chico, en Cañete, Región del Biobío. Te esperamos
          para conocer nuestra comunidad y nuestro proyecto educativo.
        </p>
        <ul class="mt-8 space-y-5">
          <li class="flex gap-4">
            <span class="grid place-items-center h-11 w-11 rounded-xl text-white shrink-0" style="background:var(--color-primary)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
            </span>
            <div><p class="font-bold">Dirección</p><p class="text-[var(--color-muted)]">{site.direccion}, {site.region}</p></div>
          </li>
          {site.telefono && (
            <li class="flex gap-4">
              <span class="grid place-items-center h-11 w-11 rounded-xl text-white shrink-0" style="background:var(--color-primary)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
              </span>
              <div><p class="font-bold">Teléfono</p><a href={`tel:${site.telefono}`} class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">{site.telefono}</a></div>
            </li>
          )}
          {site.email && (
            <li class="flex gap-4">
              <span class="grid place-items-center h-11 w-11 rounded-xl text-white shrink-0" style="background:var(--color-primary)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
              </span>
              <div><p class="font-bold">Correo</p><a href={`mailto:${site.email}`} class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">{site.email}</a></div>
            </li>
          )}
          <li class="flex gap-4">
            <span class="grid place-items-center h-11 w-11 rounded-xl text-white shrink-0" style="background:var(--color-primary)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.5-1.5h1.6V4.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.3H7.9V14h2.3v8h3.3Z"/></svg>
            </span>
            <div><p class="font-bold">Facebook</p><a href={site.facebook} target="_blank" rel="noopener" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">nuevotoqui.caupolican</a></div>
          </li>
        </ul>

        <div class="mt-8 overflow-hidden rounded-[var(--radius-card)] shadow-[var(--shadow-soft)] aspect-[4/3]">
          <iframe
            title="Ubicación de la escuela en Cañete"
            src="https://www.google.com/maps?q=Ca%C3%B1ete%2C+Regi%C3%B3n+del+Biob%C3%ADo%2C+Chile&output=embed"
            class="h-full w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>

      <!-- Formulario -->
      <div class="rounded-[var(--radius-card)] bg-white p-7 sm:p-9 shadow-[var(--shadow-card)] h-fit">
        <h2 class="text-2xl font-bold">Envíanos un mensaje</h2>
        <form id="contact-form" action={FORM_ACTION} method="POST" class="mt-6 space-y-4">
          <input type="hidden" name="_asunto" value="Contacto web — Escuela Nuevo Toqui Caupolicán" />
          <!-- honeypot anti-spam -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div>
            <label for="nombre" class="block text-sm font-bold mb-1.5">Nombre</label>
            <input id="nombre" name="nombre" required class="campo" placeholder="Tu nombre" />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="email" class="block text-sm font-bold mb-1.5">Correo</label>
              <input id="email" name="email" type="email" required class="campo" placeholder="tucorreo@mail.com" />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-bold mb-1.5">Teléfono <span class="text-[var(--color-muted)] font-normal">(opcional)</span></label>
              <input id="telefono" name="telefono" class="campo" placeholder="+56 9 ..." />
            </div>
          </div>
          <div>
            <label for="mensaje" class="block text-sm font-bold mb-1.5">Mensaje</label>
            <textarea id="mensaje" name="mensaje" required rows="5" class="campo resize-y" placeholder="Cuéntanos en qué te podemos ayudar"></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-full justify-center text-base">Enviar mensaje</button>
          <p id="form-msg" class="text-sm text-center hidden"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .campo {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: 0.625rem;
    border: 1.5px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    background: var(--color-surface);
    font-size: 0.95rem;
    transition: border-color 0.2s;
  }
  .campo:focus { outline: none; border-color: var(--color-primary); }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const msg = document.getElementById("form-msg");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if ((form.querySelector('[name="website"]') as HTMLInputElement)?.value) return; // honeypot
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = "Enviando…";
    try {
      const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error("bad status");
      (window as any).dataLayer?.push({ event: "form_submit_success", form: "contacto" });
      form.reset();
      if (msg) { msg.textContent = "¡Gracias! Recibimos tu mensaje y te responderemos pronto."; msg.className = "text-sm text-center text-green-700"; }
    } catch {
      if (msg) { msg.textContent = "No pudimos enviar el mensaje. Intenta de nuevo o escríbenos por Facebook."; msg.className = "text-sm text-center text-red-700"; }
    } finally {
      btn.disabled = false; btn.textContent = "Enviar mensaje";
    }
  });
</script>
