---
interface Props { titulo: string; texto: string; icono: string }
const { titulo, texto, icono } = Astro.props;
const paths: Record<string, string> = {
  star: "M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 17.7 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z",
  heart: "M12 20s-7-4.4-9.2-8.4C1.3 8.5 2.7 5 6 5c2 0 3.2 1.3 4 2.5C10.8 6.3 12 5 14 5c3.3 0 4.7 3.5 3.2 6.6C19 15.6 12 20 12 20z",
};
const isSun = icono === "sun";
---
<div class="group relative rounded-[var(--radius-card)] bg-white p-7 shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-card)] transition-all duration-300 hover:-translate-y-1 overflow-hidden">
  <div class="absolute -top-8 -right-8 h-28 w-28 rounded-full opacity-10 group-hover:opacity-20 transition-opacity" style="background:var(--color-accent)"></div>
  <div class="relative grid place-items-center h-14 w-14 rounded-2xl text-white" style="background:linear-gradient(135deg,var(--color-primary),var(--color-primary-dark))">
    {isSun
      ? <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
      : <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d={paths[icono]}/></svg>}
  </div>
  <h3 class="relative mt-5 text-xl font-bold">{titulo}</h3>
  <p class="relative mt-2.5 text-[var(--color-muted)] leading-relaxed">{texto}</p>
</div>
